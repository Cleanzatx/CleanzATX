{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [],
  "redirects": [
    { "source": "/home", "destination": "/", "statusCode": 301 },
    { "source": "/home/", "destination": "/", "statusCode": 301 },
    { "source": "/why-house-washing-can-help-you-sell-your-home-faster", "destination": "/", "statusCode": 301 },
    { "source": "/why-house-washing-can-help-you-sell-your-home-faster/", "destination": "/", "statusCode": 301 },
    { "source": "/barton-creek-texas", "destination": "/window-cleaning-bee-cave", "statusCode": 301 },
    { "source": "/barton-creek-texas/", "destination": "/window-cleaning-bee-cave", "statusCode": 301 },
    { "source": "/window-cleaning-westlake-hills", "destination": "/window-cleaning-bee-cave", "statusCode": 301 },
    { "source": "/window-cleaning-westlake-hills/", "destination": "/window-cleaning-bee-cave", "statusCode": 301 },
    { "source": "/window-cleaning-hudson-bend", "destination": "/window-cleaning-lake-travis", "statusCode": 301 },
    { "source": "/window-cleaning-hudson-bend/", "destination": "/window-cleaning-lake-travis", "statusCode": 301 },
    { "source": "/gallery-test", "destination": "/gallery", "statusCode": 301 },
